<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flock Watch — Community Camera Log</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
  :root{
    --paper: #EDEAE0;
    --paper-raised: #F5F3EB;
    --ink: #1B1F1D;
    --ink-soft: #4A4F49;
    --steel: #2E3D46;
    --amber: #B5720F;
    --amber-soft: #E8C98A;
    --active: #A63A2E;
    --active-bg: #F3E1DD;
    --removed: #4F7358;
    --removed-bg: #E3EBE2;
    --line: #C9C3B2;
    --line-soft: #DAD5C6;
    --font-head: 'Archivo Narrow', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
    --font-body: 'IBM Plex Sans', sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--font-body);
    line-height:1.5;
  }
  .wrap{
    max-width:900px;
    margin:0 auto;
    padding:36px 20px 80px;
  }

  /* ---- Masthead ---- */
  header.masthead{
    border-bottom:3px solid var(--ink);
    padding-bottom:18px;
    margin-bottom:28px;
  }
  .masthead-top{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:16px;
    flex-wrap:wrap;
  }
  h1{
    font-family:var(--font-head);
    font-weight:700;
    font-size:2.6rem;
    letter-spacing:0.01em;
    margin:0;
    color:var(--ink);
  }
  h1 span{color:var(--amber);}
  .tagline{
    font-family:var(--font-mono);
    font-size:0.8rem;
    color:var(--ink-soft);
    margin-top:6px;
    max-width:46ch;
  }
  .count-badge{
    font-family:var(--font-mono);
    font-size:0.78rem;
    color:var(--ink-soft);
    text-align:right;
    white-space:nowrap;
  }
  .count-badge strong{
    display:block;
    font-size:1.6rem;
    color:var(--ink);
    font-family:var(--font-head);
    line-height:1.1;
  }
  .notice{
    margin-top:14px;
    font-size:0.82rem;
    color:var(--ink-soft);
    border-left:3px solid var(--amber);
    padding:6px 0 6px 12px;
  }

  /* ---- Controls ---- */
  .controls{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    align-items:center;
    margin-bottom:22px;
  }
  input[type="text"], select, textarea, input[type="date"]{
    font-family:var(--font-body);
    font-size:0.92rem;
    background:var(--paper-raised);
    border:1px solid var(--line);
    color:var(--ink);
    padding:9px 11px;
    border-radius:3px;
  }
  input[type="text"]:focus, select:focus, textarea:focus, input[type="date"]:focus{
    outline:2px solid var(--steel);
    outline-offset:1px;
  }
  #searchInput{flex:1 1 220px;}
  #statusFilter{flex:0 0 auto;}
  .btn{
    font-family:var(--font-body);
    font-weight:600;
    font-size:0.9rem;
    border:1px solid var(--ink);
    background:var(--ink);
    color:var(--paper);
    padding:10px 16px;
    border-radius:3px;
    cursor:pointer;
    transition:transform 0.08s ease, background 0.15s ease;
  }
  .btn:hover{background:var(--steel);}
  .btn:active{transform:scale(0.98);}
  .btn.secondary{
    background:transparent;
    color:var(--ink);
  }
  .btn.secondary:hover{background:var(--paper-raised);}

  /* ---- Form panel ---- */
  .form-panel{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-left:4px solid var(--steel);
    border-radius:3px;
    padding:20px;
    margin-bottom:26px;
    display:none;
  }
  .form-panel.open{display:block;}
  .form-panel h2{
    font-family:var(--font-head);
    font-size:1.3rem;
    margin:0 0 14px;
  }
  .field-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:14px;
  }
  .field{display:flex;flex-direction:column;gap:5px;}
  .field label{
    font-family:var(--font-mono);
    font-size:0.72rem;
    color:var(--ink-soft);
  }
  .field textarea{resize:vertical;min-height:60px;}
  .form-actions{display:flex;gap:10px;margin-top:6px;}

  /* ---- List ---- */
  .entry-list{display:flex;flex-direction:column;gap:0;}
  .entry{
    border-bottom:1px solid var(--line-soft);
    padding:18px 0;
    display:grid;
    grid-template-columns:auto 1fr auto;
    gap:16px;
    align-items:start;
  }
  .entry:first-child{border-top:1px solid var(--line-soft);}
  .entry-date{
    font-family:var(--font-mono);
    font-size:0.78rem;
    color:var(--ink-soft);
    white-space:nowrap;
    padding-top:2px;
  }
  .entry-body h3{
    font-family:var(--font-head);
    font-size:1.15rem;
    margin:0 0 4px;
    font-weight:600;
  }
  .entry-photo{
    font-size:0.86rem;
    color:var(--ink-soft);
    margin:0 0 6px;
  }
  .entry-notes{
    font-size:0.92rem;
    color:var(--ink);
    margin:0 0 6px;
    white-space:pre-wrap;
  }
  .entry-meta{
    font-family:var(--font-mono);
    font-size:0.72rem;
    color:var(--ink-soft);
  }
  .status-pill{
    display:inline-block;
    font-family:var(--font-mono);
    font-size:0.72rem;
    padding:3px 9px;
    border-radius:12px;
    font-weight:500;
  }
  .status-pill.active{background:var(--active-bg);color:var(--active);}
  .status-pill.removed{background:var(--removed-bg);color:var(--removed);}
  .entry-actions{
    display:flex;
    flex-direction:column;
    gap:6px;
    align-items:flex-end;
  }
  .link-btn{
    background:none;
    border:none;
    font-family:var(--font-mono);
    font-size:0.72rem;
    color:var(--ink-soft);
    cursor:pointer;
    padding:2px 0;
    text-decoration:underline;
    text-underline-offset:2px;
  }
  .link-btn:hover{color:var(--ink);}
  .link-btn.danger:hover{color:var(--active);}

  /* ---- Empty / loading states ---- */
  .empty-state{
    padding:50px 10px;
    text-align:center;
    color:var(--ink-soft);
  }
  .empty-state p{margin:6px 0;}
  .empty-state .big{
    font-family:var(--font-head);
    font-size:1.3rem;
    color:var(--ink);
  }

  @media (max-width:640px){
    h1{font-size:2rem;}
    .field-row{grid-template-columns:1fr;}
    .entry{grid-template-columns:1fr;}
    .entry-actions{flex-direction:row;}
    .masthead-top{flex-direction:column;}
    .count-badge{text-align:left;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div class="masthead-top">
      <div>
        <h1>Flock <span>Watch</span></h1>
        <div class="tagline">A shared log of automated license-plate camera sightings — where, when, and whether it's still there.</div>
      </div>
      <div class="count-badge" id="countBadge"><strong>0</strong>logged</div>
    </div>
    <div class="notice">This log is shared — anyone using this page can see and add entries. Skip anything you wouldn't want public.</div>
  </header>

  <div class="controls">
    <input type="text" id="searchInput" placeholder="Search by location or notes…">
    <select id="statusFilter">
      <option value="all">All statuses</option>
      <option value="active">Active only</option>
      <option value="removed">Removed only</option>
    </select>
    <button class="btn" id="toggleFormBtn">+ Log a camera</button>
  </div>

  <div class="form-panel" id="formPanel">
    <h2>New sighting</h2>
    <div class="field-row">
      <div class="field">
        <label for="fLocation">LOCATION</label>
        <input type="text" id="fLocation" placeholder="Cross street, address, or landmark">
      </div>
      <div class="field">
        <label for="fDate">DATE SPOTTED</label>
        <input type="date" id="fDate">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="fStatus">STATUS</label>
        <select id="fStatus">
          <option value="active">Active</option>
          <option value="removed">Removed</option>
        </select>
      </div>
      <div class="field">
        <label for="fReporter">REPORTED BY (optional)</label>
        <input type="text" id="fReporter" placeholder="Name or initials">
      </div>
    </div>
    <div class="field-row" style="grid-template-columns:1fr;">
      <div class="field">
        <label for="fPhoto">PHOTO DESCRIPTION</label>
        <input type="text" id="fPhoto" placeholder="e.g. mounted on stop sign pole, facing north">
      </div>
    </div>
    <div class="field-row" style="grid-template-columns:1fr;">
      <div class="field">
        <label for="fNotes">NOTES</label>
        <textarea id="fNotes" placeholder="Anything else worth recording"></textarea>
      </div>
    </div>
    <div class="form-actions">
      <button class="btn" id="saveEntryBtn">Save entry</button>
      <button class="btn secondary" id="cancelFormBtn">Cancel</button>
    </div>
  </div>

  <div id="listContainer">
    <div class="empty-state"><p class="big">Loading log…</p></div>
  </div>

</div>

<script>
const SUPABASE_URL = 'https://qgymszrpaicqgiwcyxpd.supabase.co';
const SUPABASE_KEY = 'sb_publishable_VL8Zf1BFi9eFbtLNFSBMOg_3fcXxfpw';
const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
const TABLE = 'camera_entries';
let entries = [];
let editingId = null;

const listContainer = document.getElementById('listContainer');
const countBadge = document.getElementById('countBadge');
const formPanel = document.getElementById('formPanel');
const toggleFormBtn = document.getElementById('toggleFormBtn');
const cancelFormBtn = document.getElementById('cancelFormBtn');
const saveEntryBtn = document.getElementById('saveEntryBtn');
const searchInput = document.getElementById('searchInput');
const statusFilter = document.getElementById('statusFilter');

function fmtDate(iso){
  if(!iso) return '—';
  const d = new Date(iso + 'T00:00:00');
  if(isNaN(d)) return iso;
  return d.toLocaleDateString(undefined, {year:'numeric', month:'short', day:'numeric'});
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str || '';
  return div.innerHTML;
}

const SEED_ENTRIES = [
  {
    id: 'seed-zaferia',
    location: 'Shopping center near Anaheim St & Redondo Ave, Zaferia — Food 4 Less / Harbor Freight lot, Long Beach, CA',
    date: '2026-08-17',
    status: 'active',
    reporter: 'Long Beach Classic (news report)',
    photo: 'Camera visible near property entrances',
    notes: "Source: Long Beach Classic, \u201cFlock Cameras Are All Over Long Beach\u201d, Aug 17, 2026. Operated by Long Beach Police Department.",
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-1', location: 'Long Beach, CA \u2014 33.8470, -118.1252', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety. Community-verified ALPR location, not an official department list. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.8469852,-118.1251779',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-2', location: 'Long Beach, CA \u2014 33.7755, -118.1116', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~174\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7754763,-118.1116205',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-3', location: 'Long Beach, CA \u2014 33.7885, -118.1163', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~165\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7884756,-118.1163477',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-4', location: 'Long Beach, CA \u2014 33.7821, -118.1215', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~260\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7821466,-118.1214965',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-5', location: 'Long Beach, CA \u2014 33.7822, -118.1220', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Axon Enterprise, facing ~252\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7821895,-118.1220233',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-6', location: 'Long Beach, CA \u2014 33.7825, -118.1537', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~145\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7824727,-118.1536578',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-7', location: 'Long Beach, CA \u2014 33.8077, -118.1248', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~107\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.8077166,-118.1248338',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-8', location: 'Long Beach, CA \u2014 33.7894, -118.1763', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~108\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.7894104,-118.17627',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-9', location: 'Long Beach, CA \u2014 33.8071, -118.1248', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~57\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.8070842,-118.1248177',
    updatedAt: new Date().toISOString()
  },
  {
    id: 'seed-10', location: 'Long Beach, CA \u2014 33.7896, -118.1745', date: '2026-08-05', status: 'active',
    reporter: 'DeFlock / OpenStreetMap community', photo: '',
    notes: 'Operator: Flock Safety, facing ~24\u00b0. Source: DeFlock/OpenStreetMap data via mytownview.com. Map: https://www.google.com/maps/search/?api=1&query=33.789582,-118.1745153',
    updatedAt: new Date().toISOString()
  }
];

function rowToEntry(row){
  return {
    id: row.id,
    location: row.location,
    date: row.date,
    status: row.status,
    reporter: row.reporter,
    photo: row.photo,
    notes: row.notes,
    updatedAt: row.updated_at
  };
}

function entryToRow(entry){
  return {
    id: entry.id,
    location: entry.location,
    date: entry.date,
    status: entry.status,
    reporter: entry.reporter,
    photo: entry.photo,
    notes: entry.notes,
    updated_at: entry.updatedAt
  };
}

async function loadEntries(){
  const { data, error } = await db.from(TABLE).select('*');
  if(error){
    listContainer.innerHTML = `<div class="empty-state"><p class="big">Couldn't load the log</p><p>${escapeHtml(error.message)}</p></div>`;
    return;
  }
  entries = (data || []).map(rowToEntry);
  if(entries.length === 0){
    const { error: seedError } = await db.from(TABLE).insert(SEED_ENTRIES.map(entryToRow));
    if(!seedError){
      entries = SEED_ENTRIES.slice();
    }
  }
  render();
}

async function insertEntry(entry){
  const { error } = await db.from(TABLE).insert([entryToRow(entry)]);
  if(error) alert('Could not save — ' + error.message);
}

async function updateEntryRow(entry){
  const { error } = await db.from(TABLE).update(entryToRow(entry)).eq('id', entry.id);
  if(error) alert('Could not save — ' + error.message);
}

async function deleteEntryRow(id){
  const { error } = await db.from(TABLE).delete().eq('id', id);
  if(error) alert('Could not delete — ' + error.message);
}

function openForm(entry){
  editingId = entry ? entry.id : null;
  document.getElementById('fLocation').value = entry ? entry.location : '';
  document.getElementById('fDate').value = entry ? entry.date : new Date().toISOString().slice(0,10);
  document.getElementById('fStatus').value = entry ? entry.status : 'active';
  document.getElementById('fReporter').value = entry ? entry.reporter : '';
  document.getElementById('fPhoto').value = entry ? entry.photo : '';
  document.getElementById('fNotes').value = entry ? entry.notes : '';
  document.querySelector('#formPanel h2').textContent = entry ? 'Edit sighting' : 'New sighting';
  formPanel.classList.add('open');
  toggleFormBtn.textContent = 'Close form';
  document.getElementById('fLocation').focus();
}

function closeForm(){
  editingId = null;
  formPanel.classList.remove('open');
  toggleFormBtn.textContent = '+ Log a camera';
}

toggleFormBtn.addEventListener('click', () => {
  if(formPanel.classList.contains('open')){
    closeForm();
  }else{
    openForm(null);
  }
});
cancelFormBtn.addEventListener('click', closeForm);

saveEntryBtn.addEventListener('click', async () => {
  const location = document.getElementById('fLocation').value.trim();
  if(!location){
    document.getElementById('fLocation').focus();
    return;
  }
  const entryData = {
    id: editingId || (Date.now().toString(36) + Math.random().toString(36).slice(2,7)),
    location,
    date: document.getElementById('fDate').value || new Date().toISOString().slice(0,10),
    status: document.getElementById('fStatus').value,
    reporter: document.getElementById('fReporter').value.trim(),
    photo: document.getElementById('fPhoto').value.trim(),
    notes: document.getElementById('fNotes').value.trim(),
    updatedAt: new Date().toISOString()
  };

  const wasEditing = !!editingId;
  if(wasEditing){
    const idx = entries.findIndex(e => e.id === editingId);
    if(idx > -1) entries[idx] = entryData;
  }else{
    entries.push(entryData);
  }

  render();
  closeForm();
  saveEntryBtn.disabled = true;
  if(wasEditing){
    await updateEntryRow(entryData);
  }else{
    await insertEntry(entryData);
  }
  saveEntryBtn.disabled = false;
});

async function toggleStatus(id){
  const idx = entries.findIndex(e => e.id === id);
  if(idx === -1) return;
  entries[idx].status = entries[idx].status === 'active' ? 'removed' : 'active';
  entries[idx].updatedAt = new Date().toISOString();
  render();
  await updateEntryRow(entries[idx]);
}

async function deleteEntry(id){
  if(!confirm('Remove this entry from the shared log? This can\'t be undone.')) return;
  entries = entries.filter(e => e.id !== id);
  render();
  await deleteEntryRow(id);
}

function editEntry(id){
  const entry = entries.find(e => e.id === id);
  if(entry) openForm(entry);
}

function getFiltered(){
  const q = searchInput.value.trim().toLowerCase();
  const statusVal = statusFilter.value;
  return entries
    .filter(e => statusVal === 'all' || e.status === statusVal)
    .filter(e => !q || (e.location + ' ' + e.notes).toLowerCase().includes(q))
    .sort((a,b) => (b.date || '').localeCompare(a.date || ''));
}

function render(){
  const filtered = getFiltered();
  countBadge.innerHTML = `<strong>${entries.length}</strong>logged`;

  if(entries.length === 0){
    listContainer.innerHTML = `<div class="empty-state">
      <p class="big">Nothing logged yet</p>
      <p>Be the first to record a sighting.</p>
    </div>`;
    return;
  }
  if(filtered.length === 0){
    listContainer.innerHTML = `<div class="empty-state">
      <p class="big">No matches</p>
      <p>Try a different search term or filter.</p>
    </div>`;
    return;
  }

  listContainer.innerHTML = `<div class="entry-list">
    ${filtered.map(e => `
      <div class="entry">
        <div class="entry-date">${fmtDate(e.date)}</div>
        <div class="entry-body">
          <h3>${escapeHtml(e.location)}</h3>
          ${e.photo ? `<div class="entry-photo">${escapeHtml(e.photo)}</div>` : ''}
          ${e.notes ? `<div class="entry-notes">${escapeHtml(e.notes)}</div>` : ''}
          <div class="entry-meta">
            <span class="status-pill ${e.status}">${e.status === 'active' ? 'Active' : 'Removed'}</span>
            ${e.reporter ? ` · reported by ${escapeHtml(e.reporter)}` : ''}
          </div>
        </div>
        <div class="entry-actions">
          <button class="link-btn" onclick="toggleStatus('${e.id}')">Mark ${e.status === 'active' ? 'removed' : 'active'}</button>
          <button class="link-btn" onclick="editEntry('${e.id}')">Edit</button>
          <button class="link-btn danger" onclick="deleteEntry('${e.id}')">Delete</button>
        </div>
      </div>
    `).join('')}
  </div>`;
}

searchInput.addEventListener('input', render);
statusFilter.addEventListener('change', render);

loadEntries();
</script>
</body>
</html>
